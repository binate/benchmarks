package "main"

import "pkg/std/fmt"
import "pkg/std/os"

// binary-trees — see ../../../c/binary-trees.c. One Binate source, built by both
// backends. Nodes are managed (@TreeNode), so tree teardown is reference
// counting — this benchmark exercises that allocation/free path. Each tempTree
// is scoped to one loop iteration and freed when it goes out of scope.

type TreeNode struct {
	left  @TreeNode
	right @TreeNode
	item  int
}

func newNode(l @TreeNode, r @TreeNode, item int) @TreeNode {
	var n @TreeNode = make(TreeNode)
	n.left = l
	n.right = r
	n.item = item
	return n
}

func bottomUp(item int, depth int) @TreeNode {
	if depth > 0 {
		return newNode(bottomUp(2 * item - 1, depth - 1), bottomUp(2 * item, depth - 1), item)
	}
	return newNode(nil, nil, item)
}

func itemCheck(t @TreeNode) int {
	if t.left == nil {
		return t.item
	}
	return t.item + itemCheck(t.left) - itemCheck(t.right)
}

func main() {
	var args @[]readonly @[]readonly char = os.Args()
	var n int = 10
	if len(args) > 1 && len(args[1]) > 0 {
		var acc int = 0
		var okay bool = true
		for j := 0; j < len(args[1]); j++ {
			var c char = args[1][j]
			if c < '0' || c > '9' {
				okay = false
			} else {
				acc = acc * 10 + cast(int, c) - cast(int, '0')
			}
		}
		if okay {
			n = acc
		}
	}

	var minDepth int = 4
	var maxDepth int = n
	if minDepth + 2 > maxDepth {
		maxDepth = minDepth + 2
	}
	var stretchDepth int = maxDepth + 1

	var stretch @TreeNode = bottomUp(0, stretchDepth)
	fmt.Printf("stretch tree of depth %d\t check: %d\n", stretchDepth, itemCheck(stretch))

	var longLived @TreeNode = bottomUp(0, maxDepth)

	for depth := minDepth; depth <= maxDepth; depth = depth + 2 {
		var iterations int = 1 << (maxDepth - depth + minDepth)
		var check int = 0
		for i := 1; i <= iterations; i++ {
			var t1 @TreeNode = bottomUp(i, depth)
			check = check + itemCheck(t1)
			var t2 @TreeNode = bottomUp(-i, depth)
			check = check + itemCheck(t2)
		}
		fmt.Printf("%d\t trees of depth %d\t check: %d\n", iterations * 2, depth, check)
	}
	fmt.Printf("long lived tree of depth %d\t check: %d\n", maxDepth, itemCheck(longLived))
}
