package "main"

// spectral-norm — see ../../../c/spectral-norm.c for the algorithm. Single
// Binate source; the harness compiles it with both the native and the LLVM
// backend, and those two rows are the point of the benchmark.

import "pkg/std/fmt"
import "pkg/std/math"
import "pkg/std/os"

// evalA returns A(i,j) = 1 / ((i+j)(i+j+1)/2 + i + 1).
func evalA(i int, j int) float64 {
	var s int = i + j
	return 1.0 / cast(float64, s*(s+1)/2+i+1)
}

// mulAv computes out = A·v.
func mulAv(v @[]float64, out @[]float64) {
	var n int = len(v)
	for i := 0; i < n; i++ {
		var s float64 = 0.0
		for j := 0; j < n; j++ {
			s = s + evalA(i, j)*v[j]
		}
		out[i] = s
	}
}

// mulAtv computes out = Aᵀ·v.
func mulAtv(v @[]float64, out @[]float64) {
	var n int = len(v)
	for i := 0; i < n; i++ {
		var s float64 = 0.0
		for j := 0; j < n; j++ {
			s = s + evalA(j, i)*v[j]
		}
		out[i] = s
	}
}

// mulAtAv computes out = Aᵀ·A·v, using tmp as scratch.
func mulAtAv(v @[]float64, out @[]float64, tmp @[]float64) {
	mulAv(v, tmp)
	mulAtv(tmp, out)
}

func main() {
	// os.Args() elements are readonly views; read the decimal digits directly
	// rather than routing through strconv (which takes a raw byte slice).
	var args @[]readonly @[]readonly char = os.Args()
	var n int = 100
	if len(args) > 1 && len(args[1]) > 0 {
		var acc int = 0
		var okay bool = true
		for j := 0; j < len(args[1]); j++ {
			var c char = args[1][j]
			if c < '0' || c > '9' {
				okay = false
			} else {
				acc = acc*10 + cast(int, c) - cast(int, '0')
			}
		}
		if okay {
			n = acc
		}
	}
	var u @[]float64 = make_slice(float64, n)
	var v @[]float64 = make_slice(float64, n)
	var tmp @[]float64 = make_slice(float64, n)
	for i := 0; i < n; i++ {
		u[i] = 1.0
	}
	for i := 0; i < 10; i++ {
		mulAtAv(u, v, tmp)
		mulAtAv(v, u, tmp)
	}
	var vBv float64 = 0.0
	var vv float64 = 0.0
	for i := 0; i < n; i++ {
		vBv = vBv + u[i]*v[i]
		vv = vv + v[i]*v[i]
	}
	fmt.Printf("%.9f\n", math.Sqrt(vBv/vv))
}
