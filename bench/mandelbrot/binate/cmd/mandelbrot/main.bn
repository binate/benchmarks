package "main"

import "pkg/std/fmt"
import "pkg/std/os"

// mandelbrot — see ../../../c/mandelbrot.c for the algorithm. One Binate
// source, built by both backends. Emits a P4 (1-bit-per-pixel) PBM bitmap.

func main() {
	var args @[]readonly @[]readonly char = os.Args()
	var w int = 200
	if len(args) > 1 && len(args[1]) > 0 {
		var acc int = 0
		var okay bool = true
		for j := 0; j < len(args[1]); j++ {
			var c char = args[1][j]
			if c < '0' || c > '9' {
				okay = false
			} else {
				acc = acc * 10 + cast(int, c) - cast(int, '0')
			}
		}
		if okay {
			w = acc
		}
	}
	var h int = w
	var stride int = (w + 7) / 8
	var buf @[]uint8 = make_slice(uint8, h * stride)

	for y := 0; y < h; y++ {
		var rowBase int = y * stride
		var col int = 0
		var byteAcc int = 0
		var bitNum int = 0
		for x := 0; x < w; x++ {
			var Zr float64 = 0.0
			var Zi float64 = 0.0
			var Tr float64 = 0.0
			var Ti float64 = 0.0
			var Cr float64 = 2.0 * cast(float64, x) / cast(float64, w) - 1.5
			var Ci float64 = 2.0 * cast(float64, y) / cast(float64, h) - 1.0
			for i := 0; i < 50 && Tr + Ti <= 4.0; i++ {
				Zi = 2.0 * Zr * Zi + Ci
				Zr = Tr - Ti + Cr
				Tr = Zr * Zr
				Ti = Zi * Zi
			}
			byteAcc = byteAcc << 1
			if Tr + Ti <= 4.0 {
				byteAcc = byteAcc | 1
			}
			bitNum = bitNum + 1
			if bitNum == 8 {
				buf[rowBase + col] = cast(uint8, byteAcc & 255)
				col = col + 1
				byteAcc = 0
				bitNum = 0
			} else if x == w - 1 {
				byteAcc = byteAcc << (8 - w % 8)
				buf[rowBase + col] = cast(uint8, byteAcc & 255)
				col = col + 1
				byteAcc = 0
				bitNum = 0
			}
		}
	}

	var header @[]readonly char = fmt.Sprintf("P4\n%d %d\n", w, h)
	_, _ = os.Stdout.Write(header)
	_, _ = os.Stdout.Write(buf)
}
