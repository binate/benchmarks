package "main"

import "pkg/std/fmt"
import "pkg/std/math"
import "pkg/std/os"

// n-body — see ../../../c/n-body.c for the algorithm. One Binate source, built
// by both backends.

type Body struct {
	x    float64
	y    float64
	z    float64
	vx   float64
	vy   float64
	vz   float64
	mass float64
}

// makeBodies returns the Sun and the four gas giants with their standard
// initial state (velocities in AU/day, scaled by days-per-year).
func makeBodies() @[]Body {
	var pi float64 = 3.141592653589793
	var solarMass float64 = 4.0 * pi * pi
	var dpy float64 = 365.24
	var b @[]Body = make_slice(Body, 5)
	b[0].mass = solarMass
	b[1].x = 4.84143144246472090e+00
	b[1].y = -1.16032004402742839e+00
	b[1].z = -1.03622044471123109e-01
	b[1].vx = 1.66007664274403694e-03 * dpy
	b[1].vy = 7.69901118419740425e-03 * dpy
	b[1].vz = -6.90460016972063023e-05 * dpy
	b[1].mass = 9.54791938424326609e-04 * solarMass
	b[2].x = 8.34336671824457987e+00
	b[2].y = 4.12479856412430479e+00
	b[2].z = -4.03523417114321381e-01
	b[2].vx = -2.76742510726862411e-03 * dpy
	b[2].vy = 4.99852801234917238e-03 * dpy
	b[2].vz = 2.30417297573763929e-05 * dpy
	b[2].mass = 2.85885980666130812e-04 * solarMass
	b[3].x = 1.28943695621391310e+01
	b[3].y = -1.51111514016986312e+01
	b[3].z = -2.23307578892655734e-01
	b[3].vx = 2.96460137564761618e-03 * dpy
	b[3].vy = 2.37847173959480950e-03 * dpy
	b[3].vz = -2.96589568540237556e-05 * dpy
	b[3].mass = 4.36624404335156298e-05 * solarMass
	b[4].x = 1.53796971148509165e+01
	b[4].y = -2.59193146099879641e+01
	b[4].z = 1.79258772950371181e-01
	b[4].vx = 2.68067772490389322e-03 * dpy
	b[4].vy = 1.62824170038242295e-03 * dpy
	b[4].vz = -9.51592254519715870e-05 * dpy
	b[4].mass = 5.15138902046611451e-05 * solarMass
	return b
}

// offsetMomentum sets the Sun's velocity so total system momentum is zero.
func offsetMomentum(b @[]Body) {
	var px float64 = 0.0
	var py float64 = 0.0
	var pz float64 = 0.0
	for i := 0; i < len(b); i++ {
		px = px + b[i].vx * b[i].mass
		py = py + b[i].vy * b[i].mass
		pz = pz + b[i].vz * b[i].mass
	}
	b[0].vx = -px / b[0].mass
	b[0].vy = -py / b[0].mass
	b[0].vz = -pz / b[0].mass
}

func advance(b @[]Body, dt float64) {
	var n int = len(b)
	for i := 0; i < n; i++ {
		for j := i + 1; j < n; j++ {
			var dx float64 = b[i].x - b[j].x
			var dy float64 = b[i].y - b[j].y
			var dz float64 = b[i].z - b[j].z
			var d2 float64 = dx * dx + dy * dy + dz * dz
			var mag float64 = dt / (d2 * math.Sqrt(d2))
			b[i].vx = b[i].vx - dx * b[j].mass * mag
			b[i].vy = b[i].vy - dy * b[j].mass * mag
			b[i].vz = b[i].vz - dz * b[j].mass * mag
			b[j].vx = b[j].vx + dx * b[i].mass * mag
			b[j].vy = b[j].vy + dy * b[i].mass * mag
			b[j].vz = b[j].vz + dz * b[i].mass * mag
		}
	}
	for i := 0; i < n; i++ {
		b[i].x = b[i].x + dt * b[i].vx
		b[i].y = b[i].y + dt * b[i].vy
		b[i].z = b[i].z + dt * b[i].vz
	}
}

func energy(b @[]Body) float64 {
	var e float64 = 0.0
	var n int = len(b)
	for i := 0; i < n; i++ {
		e = e + 0.5 * b[i].mass * (b[i].vx * b[i].vx + b[i].vy * b[i].vy + b[i].vz * b[i].vz)
		for j := i + 1; j < n; j++ {
			var dx float64 = b[i].x - b[j].x
			var dy float64 = b[i].y - b[j].y
			var dz float64 = b[i].z - b[j].z
			var dist float64 = math.Sqrt(dx * dx + dy * dy + dz * dz)
			e = e - b[i].mass * b[j].mass / dist
		}
	}
	return e
}

func main() {
	var args @[]readonly @[]readonly char = os.Args()
	var n int = 1000
	if len(args) > 1 && len(args[1]) > 0 {
		var acc int = 0
		var okay bool = true
		for j := 0; j < len(args[1]); j++ {
			var c char = args[1][j]
			if c < '0' || c > '9' {
				okay = false
			} else {
				acc = acc * 10 + cast(int, c) - cast(int, '0')
			}
		}
		if okay {
			n = acc
		}
	}
	var b @[]Body = makeBodies()
	offsetMomentum(b)
	fmt.Printf("%.9f\n", energy(b))
	for i := 0; i < n; i++ {
		advance(b, 0.01)
	}
	fmt.Printf("%.9f\n", energy(b))
}
