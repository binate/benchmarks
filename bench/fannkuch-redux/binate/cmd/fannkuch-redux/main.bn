package "main"

import "pkg/std/fmt"
import "pkg/std/os"

// fannkuch-redux — see ../../../c/fannkuch-redux.c for the algorithm. One Binate
// source, built by both backends.

func main() {
	var args @[]readonly @[]readonly char = os.Args()
	var n int = 7
	if len(args) > 1 && len(args[1]) > 0 {
		var acc int = 0
		var okay bool = true
		for j := 0; j < len(args[1]); j++ {
			var c char = args[1][j]
			if c < '0' || c > '9' {
				okay = false
			} else {
				acc = acc * 10 + cast(int, c) - cast(int, '0')
			}
		}
		if okay {
			n = acc
		}
	}

	var perm @[]int = make_slice(int, n)
	var perm1 @[]int = make_slice(int, n)
	var count @[]int = make_slice(int, n)
	for i := 0; i < n; i++ {
		perm1[i] = i
	}

	var maxFlips int = 0
	var checksum int = 0
	var permCount int = 0
	var r int = n
	for {
		for r != 1 {
			count[r - 1] = r
			r = r - 1
		}
		for i := 0; i < n; i++ {
			perm[i] = perm1[i]
		}
		var flips int = 0
		var k int = perm[0]
		for k != 0 {
			var i int = 0
			var j int = k
			for i < j {
				var t int = perm[i]
				perm[i] = perm[j]
				perm[j] = t
				i = i + 1
				j = j - 1
			}
			flips = flips + 1
			k = perm[0]
		}
		if flips > maxFlips {
			maxFlips = flips
		}
		if permCount % 2 == 0 {
			checksum = checksum + flips
		} else {
			checksum = checksum - flips
		}
		for {
			if r == n {
				fmt.Printf("%d\nPfannkuchen(%d) = %d\n", checksum, n, maxFlips)
				return
			}
			var perm0 int = perm1[0]
			for i := 0; i < r; i++ {
				perm1[i] = perm1[i + 1]
			}
			perm1[r] = perm0
			count[r] = count[r] - 1
			if count[r] > 0 {
				break
			}
			r = r + 1
		}
		permCount = permCount + 1
	}
}
